From e61a9d48874234b2d288418f67c32d9a62b9dadb Mon Sep 17 00:00:00 2001
From: Alagu <alagupandi_pattu@comcast.com>
Date: Mon, 22 Mar 2021 08:31:59 +0000
Subject: [PATCH] TOptIAPrefix args in TClntOptIA_PD constructor

Reason for change: Ensure correct order of args while initializing the overloaded constructor of TOptIAPrefix in TClntOptIA_PD constructor

Source: COMCAST
License: "GPLv2"
Upstream-Status: Pending
Signed-off-by: Jaga <jagadheesan_duraisamy@comcast.com>
---
 ClntOptions/ClntOptIA_PD.cpp | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/ClntOptions/ClntOptIA_PD.cpp b/ClntOptions/ClntOptIA_PD.cpp
index 30fa7e9a..4fe41bde 100644
--- a/ClntOptions/ClntOptIA_PD.cpp
+++ b/ClntOptions/ClntOptIA_PD.cpp
@@ -43,9 +43,10 @@ TClntOptIA_PD::TClntOptIA_PD(SPtr<TAddrIA> addrPD, TMsg* parent)
     addrPD->firstPrefix();
     while ( ptrPrefix = addrPD->getPrefix() )
     {
-        SubOptions.append(new TOptIAPrefix(ptrPrefix->get(), zeroTimes?0:ptrPrefix->getPref(),
+        SubOptions.append(new TOptIAPrefix(ptrPrefix->get(), ptrPrefix->getLength(),
+                                               zeroTimes?0:ptrPrefix->getPref(),
                                                zeroTimes?0:ptrPrefix->getValid(),
-                                               ptrPrefix->getLength(), this->Parent) );
+                                               this->Parent) );
     }
 }
 
@@ -60,10 +61,10 @@ TClntOptIA_PD::TClntOptIA_PD(SPtr<TClntCfgPD> cfgPD, TMsg* parent)
     cfgPD->firstPrefix();
     SPtr<TClntCfgPrefix> cfgPrefix;
     while (cfgPrefix = cfgPD->getPrefix() ) {
-        SubOptions.append(new TOptIAPrefix(cfgPrefix->get(),
+        SubOptions.append(new TOptIAPrefix(cfgPrefix->get(), cfgPrefix->getLength(),
                                                cfgPrefix->getPref(),
                                                cfgPrefix->getValid(),
-                                               cfgPrefix->getLength(), 0));
+                                               0));
     }
     clearContext();
 }
